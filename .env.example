# Copy to .env and fill in values. Server loads .env from repo root on startup.

# Optional paths
# TGA_DATA=./data
# TGA_WEB=./web
# LOG_LEVEL=info

# Feedback form (Gmail: use an App Password)
# TGA_FEEDBACK_SMTP_USER=
# TGA_FEEDBACK_SMTP_PASS=
# TGA_FEEDBACK_FROM=
# TGA_FEEDBACK_TO=
# TGA_FEEDBACK_SMTP_HOST=smtp.gmail.com
# TGA_FEEDBACK_SMTP_PORT=587

# Cloudflare Turnstile (public feedback form)
# TGA_TURNSTILE_SITE_KEY=
# TGA_TURNSTILE_SECRET_KEY=

# Admin API (optional)
# TGA_ENABLE_ADMIN=1
# TGA_ADMIN_TOKEN=

# Dev / ops
# TGA_RESET_DB_ON_START=0
# TGA_ENABLE_PPROF=0
# TGA_RATE_LIMIT_RPS=0
