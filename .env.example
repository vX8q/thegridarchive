# Copy to .env and fill in values. Never commit .env (see .gitignore).
#
# Minimal local dev (no feedback email):
#   leave SMTP and Turnstile commented out — server starts on :8080
#
# Local dev with feedback email:
#   uncomment SMTP + use Cloudflare Turnstile TEST keys (work on localhost):
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/

# PORT=8080

# --- Production behind Cloudflare / nginx (required on deploy) ---
# TGA_TRUSTED_PROXY=1
# TGA_ADMIN_TOKEN=generate-a-long-random-secret
# TGA_RATE_LIMIT_RPS=15

# --- Optional admin / profiling (dev or staging only) ---
# TGA_ENABLE_ADMIN=1
# TGA_ENABLE_PPROF=1

# --- Feedback email (optional) ---
# TGA_FEEDBACK_SMTP_HOST=smtp.gmail.com
# TGA_FEEDBACK_SMTP_PORT=587
# TGA_FEEDBACK_SMTP_USER=you@gmail.com
# TGA_FEEDBACK_SMTP_PASS=your-app-password
# TGA_FEEDBACK_FROM=you@gmail.com
# TGA_FEEDBACK_TO=you@gmail.com

# Required when SMTP is set. Use TEST keys for localhost; replace with real keys on production.
# TGA_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TGA_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Docker Compose (Cloudflare Tunnel) ---
# CLOUDFLARE_TUNNEL_TOKEN=
