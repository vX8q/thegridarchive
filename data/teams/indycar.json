      "key": "Minimum weight (excl. driver / fuel)",
      "value": "Road/Street 1785 lb; Short Oval 1770 lb; Speedway 1740 lb (2026 IndyCar Rulebook Art. 14.4.1.1)"
    },
    {
      "key": "Driver equivalency weight",
      "value": "Driver + ballast brought to 185 lb; ballast in keel / approved locations (Art. 14.4.2)"
    },
    {
      "key": "Aerodynamic packages",
      "value": "Race Location Specific configurations: Road/Street & Short Oval vs Speedway front/rear wing and bodywork/underwing charts (Art. 14.7); movable aero devices while the car is in motion prohibited"
    },
    {
      "key": "Hybrid ERS / EMS (2024–present)",
      "value": "Dallara-supplied Energy Management System (EMS) as approved by IndyCar (Art. 14.12); 48 V MGU + ultracapacitor ESS in the bellhousing; about 60 hp hybrid deployment (IndyCar / Honda HRC)"
    },
    {
      "key": "Push-to-Pass (road / street)",
      "value": "ECU-controlled extra boost on road/street Events; prohibited at race starts until first alternate S/F after green, and when under lapped-car blue (Art. 14.19.13–14.19.16); oval Events use separate Event notes"
    },
    {
      "key": "Combined boost (road / street)",
      "value": "Hybrid + Push-to-Pass about 120 hp extra (IndyCar)"
    },
    {
      "key": "ERS mass",
      "value": "42.5 kg (MGU, ESS, DC/DC, VCD — Honda HRC)"
    },
    {
      "key": "ESS",
      "value": "20 supercapacitors; max operating about 60 V / 2000 A (Honda HRC)"
    },
    {
      "key": "Fuel cell capacity",
      "value": "Maximum 18.500 U.S. gallons (Art. 14.8)"
    },
    {
