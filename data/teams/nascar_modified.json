      "value": "107 in (≈ 2718 mm)"
    },
    {
      "key": "Minimum Weight",
      "value": "2,645 lb minimum / 3,200 lb maximum (with driver; fuel, oil and water; race-ready) — 2025 NWMT Rule Book Section 20D-2.2; left-side weight ≤56% of total"
    },
    {
      "key": "Engine Configuration",
      "value": "Small‑block pushrod V8"
    },
    {
      "key": "Engine Displacement",
      "value": "Minimum 350.000 cu in; built engines ≥358 cu in use additional weight formula (6.9 lb per cu in + 175 lb) — Section 20D-2.2 / 20D-5"
    },
    {
      "key": "Induction",
      "value": "4‑barrel carburetor (EFI not permitted); Holley service parts only"
    },
    {
      "key": "Carburetor Flow Limit",
      "value": "390 cfm (≈ 11 m³/min) for traditional Tour engines; Spec Engine uses Holley four-barrel as supplied"
    },
    {
      "key": "Aspiration",
      "value": "Naturally aspirated"
    },
    {
      "key": "Power Output",
      "value": "~610 hp / ~500 ft-lb for the NASCAR-Approved Spec Engine option (Robert Yates Racing Engines public Spec Engine sheet); traditional Tour engines vary — no single Tour hp figure in Section 20D"
    },
    {
      "key": "Power Limiting",
      "value": "Carburetor restrictor plate or tapered bore spacer when required by NASCAR; final size designated on the Official Entry Blank / after final practice (Section 20D-5.10.3) — not a fixed season-wide track list in the published Rule Book text"
    },
    {
      "key": "Fuel System",
      "value": "Carbureted (EFI not permitted)"
    },
    {
      "key": "Fuel Type",
      "value": "Sunoco Green E15"
    },
    {
      "key": "Fuel cell capacity",
      "value": "Maximum 24 U.S. gallons including filler spout and overflow (Section 20D fuel cell rules)"
    },
    {
      "key": "Drivetrain",
      "value": "Rear‑wheel drive (RWD)"
    },
    {
      "key": "Transmission",
